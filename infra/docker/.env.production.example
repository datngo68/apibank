# =============================================================================
# APIBank — production environment template
# =============================================================================
#
# Cách dùng:
#   1. cp infra/docker/.env.production.example .env
#   2. Chạy `bash infra/docker/bootstrap.sh` để tự sinh các secret bên dưới.
#      Hoặc tự sinh thủ công (xem comment từng biến).
#   3. Điền domain + Cloudflare token + admin info.
#   4. `docker compose -f infra/docker/docker-compose.yml up -d`
#
# Mọi giá trị có chữ "CHANGE_ME" PHẢI được thay trước khi deploy production.
# Settings sẽ raise ngay khi boot nếu phát hiện secret yếu.

# -----------------------------------------------------------------------------
# Environment & domain
# -----------------------------------------------------------------------------
APIBANK_ENVIRONMENT=production

# Domain chính phục vụ (khớp với DNS A/AAAA trên Cloudflare).
APIBANK_DOMAIN=apibank.example.com

# Email cho Let's Encrypt registration (nhận thông báo cert sắp hết hạn).
APIBANK_ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Cloudflare DNS-01 challenge
# -----------------------------------------------------------------------------
# Tạo token tại https://dash.cloudflare.com/profile/api-tokens
# Template: "Edit zone DNS" — scope: chỉ zone của domain này.
# Caddy chỉ dùng để tạo TXT record _acme-challenge tạm thời.
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_TOKEN

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
POSTGRES_DB=apibank
POSTGRES_USER=apibank
# Sinh: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

APIBANK_DB_URL=postgresql+asyncpg://apibank:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/apibank

# -----------------------------------------------------------------------------
# Redis (pub/sub + rate limit + lock)
# -----------------------------------------------------------------------------
APIBANK_REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Secrets (BẮT BUỘC sinh trước khi boot)
# -----------------------------------------------------------------------------
# Fernet keys: mã hoá credential ngân hàng + webhook secret. Có thể rotate.
# Sinh: python -c "from cryptography.fernet import Fernet; print(f'primary:{Fernet.generate_key().decode()}')"
# Hoặc: apimb fernet generate
APIBANK_FERNET_KEYS=primary:CHANGE_ME_FERNET_KEY

# API key salt: HMAC băm api_key. Phải >= 32 ký tự.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
APIBANK_API_KEY_SALT=CHANGE_ME_TOKEN_URLSAFE_48

# Session secret: ký cookie admin. Phải KHÁC api_key_salt và >= 32 ký tự.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(48))"
APIBANK_SESSION_SECRET_KEY=CHANGE_ME_TOKEN_URLSAFE_48

# Cookie Secure: tự true khi environment=production. Override nếu cần.
# APIBANK_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
APIBANK_SENTRY_DSN=
APIBANK_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Bank polling
# -----------------------------------------------------------------------------
APIBANK_POLL_INTERVAL=20
APIBANK_WEBHOOK_MAX_ATTEMPTS=7

# Node bridge fallback (tuỳ chọn) — chỉ bật khi mbbank-lib python không work:
#   docker compose --profile fallback up -d mb-bridge
APIBANK_MB_BRIDGE_URL=
MB_BRIDGE_USERNAME=
MB_BRIDGE_PASSWORD=

# -----------------------------------------------------------------------------
# Email / Telegram (tuỳ chọn — admin có thể cấu hình runtime qua UI)
# -----------------------------------------------------------------------------
APIBANK_SMTP_HOST=
APIBANK_SMTP_PORT=587
APIBANK_SMTP_USER=
APIBANK_SMTP_PASSWORD=
APIBANK_SMTP_FROM=
APIBANK_SMTP_USE_TLS=true

APIBANK_TELEGRAM_BOT_TOKEN=
APIBANK_TELEGRAM_CHAT_ID=
