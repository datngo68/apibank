APIBANK_DB_URL=postgresql+asyncpg://apibank:apibank@postgres:5432/apibank
APIBANK_REDIS_URL=redis://redis:6379/0
APIBANK_FERNET_KEYS=primary:CHANGE_ME_GENERATE_WITH_FernetCipher
APIBANK_API_KEY_SALT=CHANGE_ME_TOKEN_URLSAFE_48
APIBANK_SESSION_SECRET_KEY=CHANGE_ME_TOKEN_URLSAFE_48
# COOKIE_SECURE: tự động true ở production; có thể override bằng "true"/"false".
# APIBANK_COOKIE_SECURE=true
APIBANK_SENTRY_DSN=
APIBANK_LOG_LEVEL=INFO
# Tần suất poll bank (giây). MB chỉ cho 1 session active — nếu user dùng app
# mobile song song, worker sẽ kick session mobile mỗi `APIBANK_POLL_INTERVAL`s.
# Khuyến nghị 60-120s nếu user thường xuyên thao tác trên app mobile, hoặc
# dùng nút "Tạm ngắt" trong dashboard trước khi chuyển tiền.
APIBANK_POLL_INTERVAL=60
APIBANK_WEBHOOK_MAX_ATTEMPTS=7
